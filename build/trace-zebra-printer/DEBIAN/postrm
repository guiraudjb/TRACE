#!/bin/bash
set -e

if [ -f /usr/share/debconf/confmodule ]; then
    . /usr/share/debconf/confmodule
fi

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    systemctl disable mobitrace-print || true
fi

if [ "$1" = "purge" ]; then
    if [ -f /usr/share/debconf/confmodule ]; then
        db_purge || true
    fi
    echo "=== PURGE : Nettoyage du module d'impression Zebra ==="

    # 1. Nettoyage des fichiers applicatifs
    rm -rf /opt/mobitrace-print || true
    rm -f /etc/systemd/system/mobitrace-print.service || true
    systemctl daemon-reload || true

    # 2. Nettoyage de CUPS
    lpadmin -x Zebra_Trace 2>/dev/null || true

    # 3. Retrait des droits sudo
    rm -f /etc/sudoers.d/mobitrace-print || true

    # 4. Retrait des routes d'impression dans Nginx
    NGINX_CONF="/etc/nginx/sites-available/trace"
    if [ -f "$NGINX_CONF" ]; then
        python3 - "$NGINX_CONF" << 'PYEOF'
import sys, re

path = sys.argv[1]
with open(path) as f:
    content = f.read()

# Supprime un bloc location en comptant les accolades (gère les if imbriqués)
def remove_location(text, pattern):
    m = re.search(pattern, text)
    if not m:
        return text
    start = m.start()
    depth = 0
    i = m.start()
    while i < len(text):
        if text[i] == '{':
            depth += 1
        elif text[i] == '}':
            depth -= 1
            if depth == 0:
                # Recule pour inclure l'éventuel saut de ligne précédant le bloc
                block_start = start
                while block_start > 0 and text[block_start - 1] in (' ', '\t'):
                    block_start -= 1
                if block_start > 0 and text[block_start - 1] == '\n':
                    block_start -= 1
                return text[:block_start] + text[i + 1:]
        i += 1
    return text

for pattern in [
    r'location\s*=\s*/_zebra-auth\s*\{',
    r'location\s+/imprimer-zpl\s*\{',
    r'location\s+/imprimante/\s*\{',
]:
    content = remove_location(content, pattern)

with open(path, 'w') as f:
    f.write(content)
PYEOF
        systemctl reload nginx || true
    fi

    echo "Module d'impression supprimé."
fi

exit 0
