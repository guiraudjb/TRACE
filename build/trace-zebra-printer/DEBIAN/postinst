#!/bin/bash

set -e

. /usr/share/debconf/confmodule

db_get trace-zebra/printer_ip || true
ZEBRA_IP="$RET"

db_stop || true

exec 1>&2

echo "=== Installation du module d'impression Zebra pour TRACE ==="

[ -z "$ZEBRA_IP" ] && ZEBRA_IP="192.168.1.99"

if ! echo "$ZEBRA_IP" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
    echo "AVERTISSEMENT : Format IP invalide '$ZEBRA_IP'. Utilisation de l'adresse par défaut 192.168.1.99."
    ZEBRA_IP="192.168.1.99"
fi

echo "Adresse IP de l'imprimante : $ZEBRA_IP"


# 1. Configuration CUPS

echo "Configuration CUPS..."

lpadmin -p Zebra_Trace -E -v socket://${ZEBRA_IP}:9100 -m raw || true

cupsctl --remote-admin --no-remote-any --share-printers || true

if command -v ufw > /dev/null; then ufw allow 631/tcp > /dev/null || true; fi


# 2. Le Passe-Partout (Sudoers)

# Autorise le service web à modifier l'imprimante sans taper de mot de passe administrateur

echo "Configuration des droits système pour le micro-service..."

cat << 'EOF' > /etc/sudoers.d/mobitrace-print

www-data ALL=(ALL) NOPASSWD: /usr/sbin/lpadmin, /usr/sbin/cupsenable, /usr/sbin/cupsdisable, /usr/bin/cancel

EOF

chmod 440 /etc/sudoers.d/mobitrace-print


# 3. Le Micro-Service Python (Évolué)

echo "Déploiement du micro-service Python avancé..."

mkdir -p /opt/mobitrace-print

cat << 'EOF' > /opt/mobitrace-print/print_api.py

from flask import Flask, request, jsonify

import subprocess, re


app = Flask(__name__)

PRINTER = "Zebra_Trace"

JOB_ID_RE = re.compile(r'^[A-Za-z0-9_-]{1,64}$')


def run_cmd(cmd):

    try:

        res = subprocess.run(cmd, shell=False, check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

        return True, res.stdout

    except subprocess.CalledProcessError as e:

        return False, e.stderr


@app.route('/imprimer-zpl', methods=['POST'])

def imprimer_zpl():

    zpl_data = request.data.decode('utf-8')

    if not zpl_data.startswith('^XA'): return jsonify({"erreur": "Format ZPL invalide."}), 400

    try:

        proc = subprocess.Popen(['lp', '-d', PRINTER, '-o', 'raw'], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)

        stdout, stderr = proc.communicate(input=zpl_data.encode('utf-8'))

        if proc.returncode != 0: raise Exception(stderr.decode('utf-8'))

        return jsonify({"succes": True})

    except Exception as e:

        return jsonify({"erreur": str(e)}), 500


@app.route('/imprimante/status', methods=['GET'])

def status():

    # Lit l'état de l'imprimante

    ok_s, stat = run_cmd(["lpstat", "-p", PRINTER])

    ok_q, queue = run_cmd(["lpstat", "-o", PRINTER])

    

    jobs = []

    if ok_q and queue:

        for line in queue.strip().split('\n'):

            parts = line.split()

            if len(parts) >= 4:

                jobs.append({"id": parts[0], "size": parts[2], "date": " ".join(parts[3:])})

                

    return jsonify({"etat": stat.strip() if ok_s else "Inconnu", "jobs": jobs})


@app.route('/imprimante/action', methods=['POST'])

def action():

    act = request.json.get('action')

    job_id = request.json.get('job_id', '')

    

    if act == 'pause': ok, err = run_cmd(["sudo", "cupsdisable", PRINTER])

    elif act == 'resume': ok, err = run_cmd(["sudo", "cupsenable", PRINTER])

    elif act == 'cancel_all': ok, err = run_cmd(["sudo", "cancel", "-a", PRINTER])

    elif act == 'cancel_job':

        if not JOB_ID_RE.match(job_id):

            return jsonify({"erreur": "Identifiant de job invalide"}), 400

        ok, err = run_cmd(["sudo", "cancel", job_id])

    else: return jsonify({"erreur": "Action invalide"}), 400

    

    return jsonify({"succes": True}) if ok else jsonify({"erreur": err}), 500


@app.route('/imprimante/config', methods=['POST'])

def config():

    ip = request.json.get('ip', '').strip()

    if not re.match(r"^\d{1,3}(\.\d{1,3}){3}$", ip):

        return jsonify({"erreur": "Format IP invalide."}), 400

    

    # Change l'IP au niveau du système Linux

    ok, err = run_cmd(["sudo", "lpadmin", "-p", PRINTER, "-v", f"socket://{ip}:9100"])

    return jsonify({"succes": True}) if ok else jsonify({"erreur": err}), 500


if __name__ == '__main__':

    app.run(host='127.0.0.1', port=5050)

EOF

chown -R www-data:www-data /opt/mobitrace-print


# 4. Service SystemD

cat << 'EOF' > /etc/systemd/system/mobitrace-print.service

[Unit]

Description=Service d'impression ZPL mobiTrace

[Service]

User=www-data

WorkingDirectory=/opt/mobitrace-print

ExecStart=/usr/bin/gunicorn --workers 2 --bind 127.0.0.1:5050 print_api:app

Restart=always

[Install]

WantedBy=multi-user.target

EOF

systemctl daemon-reload && systemctl enable --now mobitrace-print || true


# 5. Injection de la route Nginx

NGINX_CONF="/etc/nginx/sites-available/trace"

if [ -f "$NGINX_CONF" ] && ! grep -q "location /imprimante/" "$NGINX_CONF"; then

    echo "Ajout des routes d'impression dans Nginx..."

    python3 - "$NGINX_CONF" << 'PYEOF'
import sys
conf_path = sys.argv[1]
with open(conf_path) as f:
    content = f.read()

block = """
    location = /_zebra-auth {
        internal;
        set $auth_header "";
        if ($http_cookie ~* "trace_token=([^;]+)") {
            set $auth_header "Bearer $1";
        }
        if ($auth_header = "") { return 401; }
        proxy_pass http://127.0.0.1:3000/rpc/me;
        proxy_set_header Authorization $auth_header;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
    }

    location /imprimer-zpl {
        auth_request /_zebra-auth;
        proxy_pass http://127.0.0.1:5050/imprimer-zpl;
    }

    location /imprimante/ {
        auth_request /_zebra-auth;
        proxy_pass http://127.0.0.1:5050/imprimante/;
    }
"""

idx = content.rfind('\n}')
with open(conf_path, 'w') as f:
    f.write(content[:idx] + block + content[idx:])
PYEOF

    systemctl reload nginx || true

fi


echo "=== Module d'impression mis à jour ! ==="

exit 0
