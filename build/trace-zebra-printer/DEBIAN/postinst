#!/bin/bash
set -e

echo "=== Installation du module d'impression Zebra pour TRACE ==="

# ==============================================================================
# 1. QUESTION INTERACTIVE (Adresse IP de l'imprimante)
# ==============================================================================
DEFAULT_IP="192.168.1.99"
ZEBRA_IP=""

echo ""
echo "------------------------------------------------------------"
if [ -t 1 ]; then
    read -p "Entrez l'adresse IP de l'imprimante Zebra [$DEFAULT_IP] : " ZEBRA_IP < /dev/tty
fi

if [ -z "$ZEBRA_IP" ]; then
    ZEBRA_IP=$DEFAULT_IP
    echo "Aucune saisie détectée. Utilisation de l'IP par défaut : $ZEBRA_IP"
else
    echo "Adresse IP enregistrée : $ZEBRA_IP"
fi
echo "------------------------------------------------------------"
echo ""

# ==============================================================================
# 2. CONFIGURATION DE CUPS (File d'attente et Interface Réseau)
# ==============================================================================
echo "Configuration de la file d'attente CUPS (Zebra_Trace)..."
lpadmin -p Zebra_Trace -E -v socket://${ZEBRA_IP}:9100 -m raw || true

echo "Ouverture de l'interface d'administration CUPS sur le réseau local..."
# Autorise l'accès distant à l'interface web de CUPS (port 631)
cupsctl --remote-admin --remote-any --share-printers || true

# Si le pare-feu UFW est installé et actif, on ouvre le port 631
if command -v ufw > /dev/null; then
    echo "Configuration du pare-feu pour le port 631..."
    ufw allow 631/tcp > /dev/null || true
fi

# ==============================================================================
# 3. CRÉATION DU MICRO-SERVICE PYTHON
# ==============================================================================
echo "Déploiement du micro-service Python..."
mkdir -p /opt/mobitrace-print
cat << 'EOF' > /opt/mobitrace-print/print_api.py
from flask import Flask, request, jsonify
import subprocess

app = Flask(__name__)

@app.route('/imprimer-zpl', methods=['POST'])
def imprimer_zpl():
    zpl_data = request.data.decode('utf-8')
    if not zpl_data.startswith('^XA'):
        return jsonify({"erreur": "Format ZPL invalide."}), 400
    try:
        process = subprocess.Popen(['lp', '-d', 'Zebra_Trace', '-o', 'raw'], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        stdout, stderr = process.communicate(input=zpl_data.encode('utf-8'))
        if process.returncode != 0:
            raise Exception(stderr.decode('utf-8'))
        return jsonify({"succes": True, "message": "Impression envoyée."}), 200
    except Exception as e:
        return jsonify({"erreur": str(e)}), 500

if __name__ == '__main__':
    app.run(host='127.0.0.1', port=5050)
EOF
chown -R www-data:www-data /opt/mobitrace-print

# ==============================================================================
# 4. CRÉATION DU SERVICE SYSTEMD
# ==============================================================================
echo "Configuration du service systemd..."
cat << 'EOF' > /etc/systemd/system/mobitrace-print.service
[Unit]
Description=Service d'impression ZPL mobiTrace
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/mobitrace-print
ExecStart=/usr/bin/gunicorn --workers 2 --bind 127.0.0.1:5050 print_api:app
Restart=always

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable mobitrace-print
systemctl restart mobitrace-print

# ==============================================================================
# 5. INJECTION DE LA ROUTE DANS NGINX
# ==============================================================================
NGINX_CONF="/etc/nginx/sites-available/trace"
if [ -f "$NGINX_CONF" ]; then
    if ! grep -q "location /imprimer-zpl" "$NGINX_CONF"; then
        echo "Ajout de la route d'impression dans Nginx..."
        sed -i -e '/^}/i \    location /imprimer-zpl {\n        proxy_pass http://127.0.0.1:5050/imprimer-zpl;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n    }\n' "$NGINX_CONF"
        systemctl reload nginx || true
    fi
fi

echo "=== Module d'impression installé avec succès ! ==="
echo ""
echo "L'interface de gestion CUPS est désormais accessible sur :"
echo "👉 http://<IP_DU_SERVEUR>:631"
echo ""
echo "RAPPEL: Pour vous y connecter, votre compte utilisateur Linux doit faire partie du groupe 'lpadmin'."
echo "Vous pouvez l'ajouter avec la commande : sudo usermod -aG lpadmin <votre_nom_utilisateur>"
exit 0
