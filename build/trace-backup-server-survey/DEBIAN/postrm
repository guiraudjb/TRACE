#!/bin/bash
set -e

if [ -f /usr/share/debconf/confmodule ]; then
    . /usr/share/debconf/confmodule
fi

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    echo "Nettoyage de la sonde de surveillance mobiTrace..."
    rm -f /usr/local/bin/mobitrace_backup_survey.sh || true
    rm -f /etc/cron.d/mobitrace-backup-survey || true
    systemctl reload cron || true
    echo "Sonde retirée avec succès."
    # (Note: Postfix n'est pas désinstallé pour ne pas casser d'autres services du serveur)
fi

if [ "$1" = "purge" ]; then
    if [ -f /usr/share/debconf/confmodule ]; then
        db_purge || true
    fi
fi

exit 0
