<!DOCTYPE html>
<html lang="fr" data-fr-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>mobiTrace - Générateur ZPL Avancé</title>
    
    <link rel="stylesheet" href="../dsfr-v1.14.3/dist/dsfr.min.css">
    
    <script src="./bwip-js-min.js"></script>
    <script src="./jspdf.umd.min.js"></script>

    <style>
        .preview-zone { 
            background-color: #eaeded; 
            padding: 2rem; 
            text-align: center; 
            min-height: 250px; 
            display: flex; 
            flex-direction: column; 
            align-items: center; 
            justify-content: center;
            border: 2px dashed #929292;
            border-radius: 4px;
        }
        #canvasPreview { 
            max-width: 100%; 
            background: white; 
            padding: 15px; 
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); 
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="fr-container fr-mt-4w">
        <h1 class="fr-h4">Générateur d'étiquettes mobiTrace (ZPL)</h1>
        
        <div class="fr-grid-row fr-grid-row--gutters">
            
            <div class="fr-col-md-6">
                <div class="fr-select-group">
                    <label class="fr-label" for="typeSelect">Format de l'étiquette</label>
                    <select id="typeSelect" class="fr-select">
                        <option value="code128">Code-Barres classique (Code 128)</option>
                        <option value="qrcode">QR Code (Haute densité)</option>
                    </select>
                </div>

                <div class="fr-input-group fr-mt-2w">
                    <label class="fr-label" for="barcodeData">Identifiant de la structure ou du mobilier</label>
                    <input type="text" id="barcodeData" class="fr-input" placeholder="Ex: MOB-000001">
                </div>

                <div class="fr-mt-4w">
                    <button id="btnGenerate" class="fr-btn fr-icon-printer-fill fr-btn--icon-left">
                        Imprimer sur la Zebra
                    </button>
                    <button id="btnPdf" class="fr-btn fr-btn--secondary fr-icon-download-fill fr-btn--icon-left fr-ml-2w">
                        Exporter l'aperçu PDF
                    </button>
                </div>
            </div>

            <div class="fr-col-md-6">
                <div class="preview-zone">
                    <canvas id="canvasPreview"></canvas>
                </div>
            </div>
            
        </div>
    </div>

    <script>
        // Récupération des éléments du DOM
        const canvas = document.getElementById('canvasPreview');
        const typeSelect = document.getElementById('typeSelect');
        const barcodeData = document.getElementById('barcodeData');

        /**
         * Met à jour l'aperçu visuel sur le canvas via bwip-js
         */
        async function updatePreview() {
            const type = typeSelect.value;
            const data = barcodeData.value || "MOBI-TRACE";
            
            try {
                // Configuration dynamique selon le type de code
                const options = {
                    bcid: type === 'qrcode' ? 'qrcode' : 'code128',
                    text: data,
                    scale: 3,
                    height: 10,
                    includetext: type === 'code128', // Afficher le texte uniquement pour le code-barres
                    textxalign: 'center'
                };
                
                bwipjs.toCanvas(canvas, options);
            } catch (e) {
                console.error("Erreur lors du rendu de l'aperçu :", e);
            }
        }

        /**
         * Génère le ZPL et l'envoie au micro-service d'impression
         */
        document.getElementById('btnGenerate').addEventListener('click', async () => {
            const type = typeSelect.value;
            const data = barcodeData.value;
            
            if (!data) {
                alert("Veuillez saisir une donnée à encoder avant d'imprimer.");
                return;
            }
            
            // Initialisation de la chaîne ZPL
            let zpl = "^XA\n^FO50,50\n";
            
            if (type === 'qrcode') {
                // Modèle QR Code (BQN) : 2 = modèle étendu, 10 = facteur de grossissement
                // FDQA = Données avec encodage automatique
                zpl += `^BQN,2,10\n^FDQA,${data}^FS\n`;
            } else {
                // Modèle Code 128 (BCN) : 100 = hauteur, Y = afficher le texte en clair
                zpl += `^BCN,100,Y,N,N\n^FD${data}^FS\n`;
            }
            
            zpl += "^XZ";

            console.log("Envoi du code ZPL à l'imprimante : \n", zpl);

            // Appel au micro-service
            try {
                const response = await fetch('/imprimer-zpl', {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain' },
                    body: zpl
                });
                
                if (response.ok) {
                    alert("Succès : L'étiquette a été envoyée à l'imprimante Zebra.");
                } else {
                    throw new Error("Erreur serveur : " + response.statusText);
                }
            } catch (error) {
                console.error("Échec de l'impression :", error);
                alert("Erreur réseau ou d'impression : " + error.message);
            }
        });

        /**
         * Exporte l'aperçu généré en document PDF
         */
        document.getElementById('btnPdf').addEventListener('click', () => {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();
            
            // Récupération de l'image rasterisée depuis le canvas
            const imgData = canvas.toDataURL('image/png');
            
            // Mise en page du PDF
            doc.setFontSize(16);
            doc.text("Étiquette de traçabilité - mobiTrace", 10, 15);
            
            doc.setFontSize(11);
            doc.text("Format : " + (typeSelect.value === 'qrcode' ? 'QR Code' : 'Code 128'), 10, 25);
            doc.text("Valeur encodée : " + (barcodeData.value || "MOBI-TRACE"), 10, 32);
            
            // Adaptation de la taille de l'image sur le PDF selon le format
            const imgWidth = typeSelect.value === 'qrcode' ? 50 : 70;
            const imgHeight = typeSelect.value === 'qrcode' ? 50 : 30;
            
            doc.addImage(imgData, 'PNG', 10, 45, imgWidth, imgHeight);
            
            // Téléchargement du fichier
            doc.save('etiquette_mobitrace.pdf');
        });

        // Déclencheurs pour mettre à jour l'aperçu en temps réel
        barcodeData.addEventListener('input', updatePreview);
        typeSelect.addEventListener('change', updatePreview);
        
        // Initialisation de l'aperçu au chargement de la page
        window.addEventListener('DOMContentLoaded', updatePreview);
    </script>
</body>
</html>
